<?xml version="1.0" encoding="utf-8"?>
<!-- 对话框背景（深色模式）：深紫渐变 + 细描边，圆角卡片 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#2A2126"
        android:centerColor="#251C22"
        android:endColor="#1F171C" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#55E07A9E" />
</shape>
