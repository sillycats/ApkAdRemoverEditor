<?xml version="1.0" encoding="utf-8"?>
<!-- 对话框次按钮（深色模式）：描边圆角 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#22E07A9E" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#66E07A9E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#129A7BD6" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#669A7BD6" />
        </shape>
    </item>
</selector>
