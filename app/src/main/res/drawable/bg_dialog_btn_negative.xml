<?xml version="1.0" encoding="utf-8"?>
<!-- 对话框次按钮：描边圆角 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#14E64E87" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#66E64E87" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08B388FF" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#66B388FF" />
        </shape>
    </item>
</selector>
