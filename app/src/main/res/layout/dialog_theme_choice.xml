<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择显示模式"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:text="切换后立即生效，设置将被保存"
        android:textColor="@color/text_hint"
        android:textSize="12sp" />

    <!-- 跟随系统 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/optionSystem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/primary"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivSystemIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_round"
                android:contentDescription="跟随系统"
                android:padding="8dp"
                android:src="@drawable/ic_system_mode"
                app:tint="@color/primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="跟随系统"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="自动根据系统深浅色切换"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivSystemCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="已选"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/accent" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 白天模式 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/optionLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/primary_light"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivLightIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_round"
                android:contentDescription="白天"
                android:padding="8dp"
                android:src="@drawable/ic_light_mode"
                app:tint="@color/accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="白天模式"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="始终使用浅色界面"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivLightCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="已选"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/accent" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 夜间模式 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/optionDark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/primary_light"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivDarkIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_round"
                android:contentDescription="夜间"
                android:padding="8dp"
                android:src="@drawable/ic_dark_mode"
                app:tint="@color/primary_dark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="夜间模式"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="始终使用深色界面"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivDarkCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="已选"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/accent" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>